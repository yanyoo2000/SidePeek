{
  "manifest_version": 3,
  "name": "SidePeek",
  "version": "0.1.0",
  "description": "点视频不再丢页面 —— 在 B 站右侧抽屉里速览视频，看完关掉，原页面滚动位置和搜索结果都还在。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SidePeek 侧边抽屉速览",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.bilibili.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["src/core/peek-drawer.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
